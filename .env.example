# =====================================================================
# VIT-AP SMART TRANSIT — ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Supabase Cloud Connection (Optional for initial evaluation)
# When provided, data syncs to your live Supabase PostgreSQL database.
# When omitted, the platform runs in full interactive demonstration mode
# using the in-memory repository (data is lost on restart).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Cryptographic Salt for Ticket QR Signing
# Used to generate and verify HMAC-SHA256 signatures on passenger tickets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRANSIT_SECRET_SALT=replace-with-a-long-random-secret

# 3. Google Maps Platform or OpenStreetMap
# Optional API key for Google Maps Platform. When omitted, the platform
# uses the built-in Leaflet + OpenStreetMap engine with customized branding.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 4. University Identity & Domain Policies
NEXT_PUBLIC_INSTITUTION_NAME="VIT-AP University"
NEXT_PUBLIC_CAMPUS_LOCATION="Inavolu, Beside AP Secretariat, Amaravati, Andhra Pradesh 522237"
NEXT_PUBLIC_PERMITTED_EMAIL_DOMAINS="vitap.ac.in,student.vitap.ac.in"

# 5. Payment Gateway (Disabled until authorized university merchant credentials supplied)
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 6. External SMS / Email Notifications
SMS_NOTIFICATIONS_ENABLED=false
SMS_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 7. GPS device ingestion (server-only)
# Comma-separated busId:key pairs. A tracking device/driver app sends its key as
# "Authorization: Bearer <key>"; the key identifies the bus, and positions are accepted only
# for the trip that bus is currently assigned to. Generate keys with the command above.
GPS_DEVICE_KEYS=

# 8. Road routing (used only by scripts/build-route-geometry.mjs, never at request time)
# Defaults to the public OSRM demo server, which is for light, non-commercial use only.
# Point this at a self-hosted OSRM instance for production use.
OSRM_BASE_URL=https://router.project-osrm.org
